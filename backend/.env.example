# Copy to backend/.env and adjust. Never commit the real .env file.

# --- Core -------------------------------------------------------------
# Development only. Generate a real key for any shared environment:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=insecure-dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------
# Matches the defaults in docker-compose.yml.
DATABASE_URL=postgres://merchantflow:merchantflow_dev@127.0.0.1:5432/merchantflow

# --- Browser security -------------------------------------------------
# Origins allowed to make state-changing requests (the Vite dev server).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set both to true whenever the site is served over HTTPS.
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false

# --- API --------------------------------------------------------------
# Failed-login rate limit per client IP.
LOGIN_THROTTLE_RATE=10/min
# Swagger UI and the OpenAPI schema. Defaults to the value of DJANGO_DEBUG.
# API_DOCS_ENABLED=true
